# Configuracion local de ejemplo. No contiene credenciales reales.
ENVIRONMENT=dev
PORT=8080
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=eventflow
DB_PASSWORD=change-me
DB_NAME=eventflow
DB_SSL_MODE=disable
LOG_LEVEL=info
LOG_FORMAT=json
REQUEST_TIMEOUT=10s
SHUTDOWN_TIMEOUT=15s

# Configuracion reservada para la futura integracion del worker.
AMQP_URL=amqp://guest:guest@127.0.0.1:5672/
OUTBOX_POLL_INTERVAL=500ms
OUTBOX_BATCH_SIZE=20
PUBLISH_CONFIRM_TIMEOUT=5s
CONSUMER_PREFETCH=1
